<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Curso en árabe para nivel A1-A2 para estudiantes hispanohablantes</title>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
  <meta name="description" content="Descripción de tu curso.">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
  
  <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/docsify@4/lib/themes/vue.css">
</head>
<body>
  <div id="app">جارٍ تحميل الدورة...</div>
  <script>
    window.$docsify = {
      name: 'Curso en árabe para nivel A1-A2 para estudiantes hispanohablantes',
      repo: 'https://github.com/albaromogutierrez/repositorio-arabe', // Enlace a tu repositorio en la esquina superior
      loadSidebar: true,     // Activa el menú lateral autogestionado
      subMaxLevel: 2,        // Muestra los subtítulos (h2, h3) de cada lección en el menú
      loadNavbar: false,     // Cambia a true si quieres menú superior
      auto2top: true,        // Hace scroll hacia arriba automáticamente al cambiar de tema
      
      // Configuración del buscador integrado
      search: {
        maxAge: 86400000,
        paths: 'سيارة',
        placeholder: 'البحث في الدورة...',
        noData: 'لم يتم العثور على نتائج!',
        depth: 6
      }
    }
  </script>
  <script src="//cdn.jsdelivr.net/npm/docsify@4"></script>
  <script src="//cdn.jsdelivr.net/npm/docsify/lib/plugins/search.min.js"></script>
  <script src="//cdn.jsdelivr.net/npm/docsify/lib/plugins/clickable-copy-code.min.js"></script>
</body>
</html>